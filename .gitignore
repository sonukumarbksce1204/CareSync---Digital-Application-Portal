# ── User-uploaded media (production uses Cloudinary; local folder not needed in repo) ──
media/

# ── Python bytecode ────────────
*.exe
*.pyc
*.pyo
__pycache__/

# ── Environment / secrets ───────────────────────────────────────────────────
.env
.env.*
*.env

# ── Local database (never commit — production uses Neon Postgres) ──────────
*.sqlite3

# ── Deployment helper (fine to commit as it contains no secrets, but keeping
#    it local avoids HF secret-scanning false positives on stale tokens) ────
deploy_to_hf.py

# ── Collected static files (generated by collectstatic during Docker build) ─
staticfiles/

# ── Debug / diagnostic output files ────────────────────────────────────────
debug_hf.txt
out.txt
check_output.txt
db_check_result.txt
diag_output.txt
test_out.txt
test_out_hf.txt
diag.py
diag_output.txt